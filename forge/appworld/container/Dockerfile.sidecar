FROM python:3.11-slim

# AppWorld + the specialists + the oracle live here, and only here. The agent's
# container (service `main`) has none of it -- see docker-compose.yaml.
# build-essential is needed: appworld pulls psutil, which has no arm64 wheel on
# python:3.11-slim and falls back to compiling.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

# Pinned. Unpinned, a task rendered today and the same task rebuilt in six
# months are different experiments sharing a task id, and every measurement in
# WRITEUP.md would be attributed to whatever happened to be on PyPI that
# morning. The sandbox in particular is written against appworld 0.1.3's
# SafetyGuard: it assumes `world.execute()` runs in-process and that AppWorld's
# own guard does not contain an adversary. A silent upgrade could change both.
RUN pip install --no-cache-dir appworld==0.1.3.post1 openai==2.16.0

WORKDIR /opt/maf
ENV APPWORLD_ROOT=/opt/maf

# Fetch the dataset at build time, not from the task directory. Copying 183M of
# AppWorld into every rendered task would make the repo unusable and the tasks
# un-reviewable; this way the layer is cached across every task built from this
# image, which is the same shared-base-image trick SWE-smith uses to get 50k
# tasks out of 295GB.
#
# NOT REPRODUCIBLE, and not fixable from here: `appworld download data` takes no
# version (see appworld/download.py:14 -- `download_data()` has no arguments), so
# this pulls whatever the current dataset is. The packages above are pinned; the
# data is not. Pinning it needs either a base image published at a known digest
# or a vendored dataset snapshot. Task ids are stable across releases so far,
# which is luck, not a guarantee.
RUN appworld install && appworld download data

COPY server.py /opt/maf/server.py

# The dimension's own runtime: the specialist loop and the constraint
# enforcement. Copied into the sidecar, never into the agent's image.
COPY maf_appworld /opt/maf/forge/appworld
# The model-class parity rule (runtime.py imports it): a specialist below the
# Main's model class is refused before any episode runs.
COPY maf_models.py /opt/maf/forge/models.py
RUN touch /opt/maf/forge/__init__.py
ENV PYTHONPATH=/opt/maf

EXPOSE 8079
CMD ["python", "/opt/maf/server.py"]
