FROM python:3.11-slim

# The simulated world + the specialists + the judge live here, and only here.
# The agent's container (service `main`) has none of it -- see
# docker-compose.yaml.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

# The same file the local .venv-gaia2 installs -- repo root's
# requirements-gaia2.txt, shipped verbatim into every rendered task by
# harbor.VERBATIM_COPIES. This line used to repeat the two pins by hand, which
# meant the sweep's environment and the shipped task's environment were two
# lists that nothing compared. There is one list now, and it is fully closed:
# all 95 transitive versions, not just the two anyone thinks to bump.
#
# It is resolved `--universal`, so this linux/amd64 image and the maintainer's
# macos/arm64 venv install the same versions rather than two resolutions of the
# same constraints.
#
# The official harness (Meta's Agents Research Environments; import name
# are.simulation) needs pydantic 2, which is why this sidecar exists at all:
# the AppWorld sidecar's environment carries pydantic 1 and the two cannot
# share an image.
COPY requirements.txt /opt/maf/requirements.txt
RUN pip install --no-cache-dir -r /opt/maf/requirements.txt

WORKDIR /opt/maf

# The whole scenario -- initial app states, scheduled events, oracle writes --
# ships in the task. Unlike AppWorld's dataset there is nothing to download
# at build time, so a rendered task is reproducible from its own directory.
COPY scenario.json /opt/maf/scenario.json

COPY server.py /opt/maf/server.py

# The runtime the sidecar imports: the Gaia2 specialist loop and world
# adapter, the constraint definitions it shares with AppWorld, and the
# model-class parity rule. Copied into the sidecar, never into the agent's
# image.
COPY maf_gaia2 /opt/maf/forge/gaia2
COPY maf_appworld /opt/maf/forge/appworld
COPY maf_models.py /opt/maf/forge/models.py
RUN touch /opt/maf/forge/__init__.py
ENV PYTHONPATH=/opt/maf

EXPOSE 8080
CMD ["python", "/opt/maf/server.py"]
