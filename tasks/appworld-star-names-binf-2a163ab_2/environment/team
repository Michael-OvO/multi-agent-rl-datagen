#!/usr/bin/env python3
"""The Main's entire interface to the world.

This is everything the model under test can reach. It is a ~60-line HTTP client
with three verbs and no dependencies. There is no AppWorld in this container, no
specialist code, no task ground truth, and no scorer -- so "the Main has no API
access" is a fact about what is on disk, not a rule it is asked to follow.

    team roster
    team ask <specialist> "<request in plain English>"
    team done "<answer>"
"""

import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("MAF_ENV_URL", "http://maf-env:8079")


def _call(method, path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        BASE + path, data=data, method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}", "detail": e.read().decode()[:200]}
    except Exception as e:
        return {"error": f"{type(e).__name__}: {e}"}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.split("    team roster")[0].strip())
        print("\n  team roster")
        print('  team ask <specialist> "<request>"')
        print('  team done "<answer>"')
        return 0

    cmd = argv[0]

    if cmd == "roster":
        print(json.dumps(_call("GET", "/roster"), indent=1))
        return 0

    if cmd == "ask":
        if len(argv) < 3:
            print('usage: team ask <specialist> "<request>"', file=sys.stderr)
            return 2
        who, brief = argv[1], " ".join(argv[2:])
        print(json.dumps(_call("POST", "/ask",
                               {"specialist": who, "brief": brief}), indent=1))
        return 0

    if cmd == "done":
        answer = " ".join(argv[1:]) if len(argv) > 1 else "completed"
        print(json.dumps(_call("POST", "/done", {"answer": answer}), indent=1))
        return 0

    print(f"unknown command {cmd!r}. Try: roster | ask | done", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
