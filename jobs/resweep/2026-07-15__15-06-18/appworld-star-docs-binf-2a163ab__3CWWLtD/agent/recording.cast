[25.121294, "o", "{\r\n \"report\": \"The names and identifying details of your roommates are:\\n1. Anthony Harrison, email: an-harrison@gmail.com, phone: 2466064078\\n2. Anita Burch, email: anita.burch@gmail.com, phone: 3643463570\\n3. Nicholas Weber, email: nicholas.weber@gmail.com, phone: 9503658964\\nAll share the home address: 247 Salinas Pines Suite 668, Seattle, WA 11799.\",\r\n \"delegations_used\": 1,\r\n \"budget\": null\r\n}\r\n"]
